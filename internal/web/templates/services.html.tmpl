{{/* services.html.tmpl — shell + per-section blocks.

The shell renders once on view-reveal and contains only static structure
plus per-section placeholders. Each section self-polls its own endpoint:

  /partials/services            → "shell"           (this file, once on reveal)
  /partials/services/bridges    → "bridges-section" (no poll; action-only)
  /partials/services/containers → "containers-section" (every 8s)
  /partials/services/open-design?name=X → "open-design-card" (every 8s, per project)
  /partials/services/vaults     → "vaults-section"  (every 8s)
  /partials/services/instances?name=X → "instance-section" (every 8s, per compose instance)

No outer-panel poll, no structural ETag, no JS ETag tracker — flicker
control falls out of the architecture instead of a workaround. See
docs/frontend-architecture.md §7.10.

Action buttons keep targeting #services-inner with outerHTML for cross-
section refreshes — actions are user-initiated and rare, so the brief
"loading…" flash on each section while they re-fetch is acceptable.
*/}}

{{define "shell"}}
<div class="svc-grid" id="services-inner">
  {{if .HasBridges}}
  {{/* Bridges section has no periodic poll — state changes only via
       action buttons (apply, reload, per-bridge stop/start). hx-trigger="load"
       fetches once when the shell mounts; subsequent updates come from
       action button responses targeting #services-inner. */}}
  <div id="bridges-section" class="svc-instance svc-section-loading"
       hx-get="/partials/services/bridges"
       hx-trigger="load"
       hx-swap="outerHTML">
    <p class="svc-section-placeholder">loading bridges…</p>
  </div>
  {{end}}

  {{if .HasContainers}}
  <div id="containers-section" class="svc-instance svc-section-loading"
       hx-get="/partials/services/containers"
       hx-trigger="load, every 8s"
       hx-swap="outerHTML">
    <p class="svc-section-placeholder">loading containers…</p>
  </div>
  {{end}}

  {{range .OpenDesignNames}}
  <div id="open-design-{{.}}" class="svc-instance svc-section-loading"
       hx-get="/partials/services/open-design?name={{. | qesc}}"
       hx-trigger="load, every 8s"
       hx-swap="outerHTML">
    <p class="svc-section-placeholder">loading open design…</p>
  </div>
  {{end}}

  {{if .HasVaults}}
  <div id="vaults-section" class="svc-instance svc-section-loading"
       hx-get="/partials/services/vaults"
       hx-trigger="load, every 8s"
       hx-swap="outerHTML">
    <p class="svc-section-placeholder">loading vaults…</p>
  </div>
  {{end}}

  {{if .InstanceNames}}
  {{range .InstanceNames}}
  <div id="instance-{{.}}" class="svc-instance svc-section-loading"
       hx-get="/partials/services/instances?name={{. | qesc}}"
       hx-trigger="load, every 8s"
       hx-swap="outerHTML">
    <p class="svc-section-placeholder">loading process-compose · {{.}}…</p>
  </div>
  {{end}}
  {{else}}
  <p style="color:var(--text3);font-style:italic">no process-compose instances configured — add them to config.yaml</p>
  {{end}}
</div>
{{end}}

{{define "bridges-section"}}
<div id="bridges-section" class="svc-instance bridges">
  <div class="svc-header">
    <span class="svc-icon" title="network bridges">⇄</span>
    <span class="svc-name">network bridges</span>
    <span class="svc-endpoint">portproxy + firewall · persistent state</span>
    <div class="svc-actions">
      <span class="svc-running-count">{{activeBridgeCount .Bridges}}/{{len .Bridges}} active</span>
      <button class="svc-boot-btn start"
              hx-post="/bridges/apply"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="re-apply every Windows-tier bridge in one UAC prompt">apply all</button>
      <button class="svc-boot-btn restart"
              hx-post="/bridges/refresh"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="reload bridges.yaml from disk and re-snapshot state">reload</button>
    </div>
  </div>
  <table class="process-table">
    <thead><tr>
      <th class="col-name">name</th><th>tier</th><th class="col-state">state</th><th>listen</th><th>connect</th><th class="col-actions"></th>
    </tr></thead>
    <tbody>
    {{range .Bridges}}
    {{if eq .Kind "composite"}}
    <tr class="bridge-composite" data-composite="{{.Name}}">
      <td colspan="6" class="bridge-composite-cell">
        <div class="bridge-composite-row">
          <span class="bridge-disclosure">{{chevSVG}}</span>
          <span class="proc-name">{{.Name}}</span>
          <span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span>
          <span class="bridge-composite-hops">{{len .Members}} hop{{if ne (len .Members) 1}}s{{end}}</span>
          <span class="kicker bridge-composite-kicker">composite</span>
          {{if .Description}}<span class="bridge-composite-desc">{{.Description}}</span>{{end}}
          <div class="proc-actions bridge-composite-actions">
            <button class="proc-btn start"
                    hx-post="/bridge/apply?name={{ .Name | qesc }}"
                    hx-target="#services-inner" hx-swap="outerHTML"
                    title="bring composite to active state; skips UAC if Windows portproxy is already in place">apply</button>
            <button class="proc-btn restart"
                    hx-post="/bridge/pause?name={{ .Name | qesc }}"
                    hx-target="#services-inner" hx-swap="outerHTML"
                    title="pause: stop WSL relay + remove Windows portproxy. Smart-skips elevation if Windows side is already inactive; otherwise UAC."
                    hx-confirm="Pause composite {{.Name}}? Removing the Windows portproxy will request elevation if the rule is currently in place.">pause</button>
            <button class="proc-btn stop"
                    hx-get="/partials/blast-radius?action=bridge-reset&name={{ .Name | qesc }}"
                    hx-target="#blast-slot" hx-swap="innerHTML">reset</button>
          </div>
        </div>
      </td>
    </tr>
    {{$parentName := .Name}}
    {{range .Members}}
    <tr class="bridge-member" data-member-of="{{$parentName}}" hidden>
      <td class="col-name bridge-member-name">
        <span class="bridge-member-indent">└</span>
        <span class="proc-name">{{.Name}}</span>
        {{if .DisplayName}}<div class="proc-ns">{{.DisplayName}}</div>{{end}}
      </td>
      <td><span class="tier-badge {{.Tier}}">{{.Tier}}</span></td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td><code>{{.Listen}}</code></td>
      <td><code>{{.Connect}}</code></td>
      <td class="col-actions"></td>
    </tr>
    {{end}}
    {{else}}
    <tr>
      <td class="col-name">
        <div class="proc-name">{{.Name}}</div>
        {{if .DisplayName}}<div class="proc-ns">{{.DisplayName}}</div>{{end}}
      </td>
      <td><span class="tier-badge {{.Tier}}">{{.Tier}}</span></td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td><code>{{.Listen}}</code></td>
      <td><code>{{.Connect}}</code></td>
      <td class="col-actions">
        <div class="proc-actions">
          <button class="proc-btn start"
                  hx-post="/bridge/apply?name={{ .Name | qesc }}"
                  hx-target="#services-inner" hx-swap="outerHTML">apply</button>
          {{if eq .Tier "wsl"}}
          <button class="proc-btn restart"
                  hx-post="/bridge/pause?name={{ .Name | qesc }}"
                  hx-target="#services-inner" hx-swap="outerHTML"
                  title="pause: stop the relay process; reset to fully remove">pause</button>
          {{end}}
          <button class="proc-btn stop"
                  hx-get="/partials/blast-radius?action=bridge-reset&name={{ .Name | qesc }}"
                  hx-target="#blast-slot" hx-swap="innerHTML">reset</button>
        </div>
      </td>
    </tr>
    {{end}}
    {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "containers-section"}}
<div id="containers-section" class="svc-instance containers"
     hx-get="/partials/services/containers"
     hx-trigger="every 8s"
     hx-swap="outerHTML">
  <div class="svc-header">
    <span class="svc-icon" title="docker containers">⬢</span>
    <span class="svc-name">containers</span>
    {{if .Docker.Configured}}
    <span class="online-dot {{if .Docker.Online}}online{{else}}offline{{end}}"
          title="docker daemon {{if .Docker.Online}}reachable{{else}}unreachable{{if .Docker.Error}} — {{.Docker.Error}}{{end}}{{end}}"></span>
    {{end}}
    <span class="svc-endpoint">{{if .Docker.Endpoint}}docker: {{.Docker.Endpoint}}{{else}}docker: matched by name{{end}}</span>
    <div class="svc-actions">
      <span class="svc-running-count">{{runningContainerCount .Containers}}/{{len .Containers}} running</span>
      <button class="svc-boot-btn restart"
              hx-post="/containers/refresh"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="reload containers.yaml from disk and re-snapshot state">reload</button>
    </div>
  </div>
  <table class="process-table">
    <thead><tr>
      <th class="col-name">name</th><th class="col-state">state</th><th>status</th><th>cpu</th><th>mem</th><th>id</th><th class="col-actions"></th>
    </tr></thead>
    <tbody>
    {{range .ContainerProjects}}
    {{$projName := .Name}}
    <tr class="project-header" data-project="{{.Name}}">
      <td class="col-name">
        <div class="proc-name">
          <span class="project-disclosure">{{chevSVG}}</span>
          <span class="project-name">{{.Name}}</span>
          <span class="kicker project-kind-label">compose</span>
        </div>
        {{if .Description}}<div class="proc-ns">{{.Description}}</div>{{end}}
      </td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td colspan="4">{{if .ComposeFile}}<code class="proc-compose-file">{{.ComposeFile}}</code>{{else}}—{{end}}</td>
      <td class="col-actions">
        <div class="proc-actions">
          {{if eq .StateClass "running"}}
          <button class="proc-btn stop"
                  hx-get="/partials/blast-radius?action=decl-container-stop&name={{ .Name | qesc }}"
                  hx-target="#blast-slot" hx-swap="innerHTML">stop</button>
          {{else}}
          <button class="proc-btn start"
                  hx-post="/decl-container/start?name={{ .Name | qesc }}"
                  hx-target="#services-inner" hx-swap="outerHTML">start</button>
          {{end}}
        </div>
      </td>
    </tr>
    {{range .Containers}}
    <tr class="project-member" data-project="{{$projName}}">
      <td class="col-name">
        <span class="project-member-indent">└</span>
        <span class="proc-name">{{.Name}}</span>
      </td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td>{{if .Status}}<code>{{.Status}}</code>{{else}}—{{end}}</td>
      <td>—</td>
      <td>—</td>
      <td>{{if .ID}}<code>{{.ID}}</code>{{else}}—{{end}}</td>
      <td class="col-actions"></td>
    </tr>
    {{end}}
    {{end}}{{/* end range .ContainerProjects */}}
    {{if and .ContainerProjects .Containers}}
    <tr class="standalone-divider">
      <td colspan="7"><span class="kicker">standalone · {{len .Containers}} container{{if ne (len .Containers) 1}}s{{end}}</span></td>
    </tr>
    {{end}}
    {{range .Containers}}
    <tr>
      <td class="col-name">
        <div class="proc-name">{{.Name}}</div>
        {{if .Description}}<div class="proc-ns">{{.Description}}</div>{{end}}
      </td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td>{{if .Status}}<code>{{.Status}}</code>{{else}}—{{end}}</td>
      <td>
        {{if .HasStats}}
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill {{cpuBarClass .CPU}}" style="width:{{cpuBarWidth .CPU}}%"></div></div>
          <span class="usage-val">{{printf "%.1f" .CPU}}%</span>
        </div>
        {{else}}—{{end}}
      </td>
      <td>
        {{if .HasStats}}
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill mem" style="width:{{memBarWidth .Mem}}%"></div></div>
          <span class="usage-val">{{formatMem .Mem}}</span>
        </div>
        {{else}}—{{end}}
      </td>
      <td>{{if .ID}}<code>{{.ID}}</code>{{else}}—{{end}}</td>
      <td class="col-actions">
        <div class="proc-actions">
          {{if eq .StateClass "running"}}
          <button class="proc-btn stop"
                  hx-get="/partials/blast-radius?action=decl-container-stop&name={{ .Name | qesc }}"
                  hx-target="#blast-slot" hx-swap="innerHTML">stop</button>
          {{else if .ID}}
          <button class="proc-btn start"
                  hx-post="/decl-container/start?name={{ .Name | qesc }}"
                  hx-target="#services-inner" hx-swap="outerHTML">start</button>
          {{end}}
        </div>
      </td>
    </tr>
    {{end}}{{/* end range .Containers (standalone rows) */}}
    </tbody>
  </table>
</div>
{{end}}

{{define "open-design-card"}}
{{$live := eq .Card.StateClass "running"}}
<div id="open-design-{{.Card.Name}}"
     class="svc-instance open-design{{if not $live}} open-design-down{{end}}"
     hx-get="/partials/services/open-design?name={{ .Card.Name | qesc }}"
     hx-trigger="every 8s"
     hx-swap="outerHTML">
  <div class="svc-header">
    <span class="svc-icon od-glyph" title="Open Design compose project">◇</span>
    <span class="svc-name">open design</span>
  </div>
  {{/* Meta row — state-aware. Status pill, project name (dims when down),
       description, web URL chip (muted + non-interactive when down),
       snapshot timestamp slot (populated via OOB). */}}
  <div class="ods-meta">
    <span class="status-pill {{.Card.StateClass}}" id="ods-pill-{{.Card.Name}}"><span class="dot"></span>{{.Card.State}}</span>
    <span class="ods-name{{if not $live}} ods-name-dim{{end}}">{{.Card.Name}}</span>
    {{if .Card.Description}}<span class="ods-desc">{{.Card.Description}}</span>{{end}}
    {{if .Card.WebURL}}
    {{if $live}}
    <a class="ods-web-chip" href="{{.Card.WebURL}}" target="_blank" rel="noopener" title="{{.Card.WebURL}}">{{stripScheme .Card.WebURL}}<span class="ods-web-chip-arrow" aria-hidden="true">↗</span></a>
    {{/* Daemon version chip — self-polls every 60s. hx-preserve keeps the
         loaded chip across this card's 8s outerHTML swap so the version
         doesn't blink back to "v…" on every refresh. */}}
    <span class="ods-version-chip ods-version-chip-loading"
          id="ods-version-{{.Card.Name}}"
          hx-preserve="true"
          hx-get="/partials/open-design/version?name={{ .Card.Name | qesc }}"
          hx-trigger="load, every 60s"
          hx-swap="outerHTML">v…</span>
    {{else}}
    <span class="ods-web-chip ods-web-chip-muted" title="web ui unreachable — project is not running">{{stripScheme .Card.WebURL}}<span class="ods-web-chip-arrow" aria-hidden="true">↗</span></span>
    {{end}}
    {{end}}
    <span class="ods-meta-spacer"></span>
    {{/* ID keyed off TokenStatsContainer so the OOB swap from the token-
         stats partial finds it. hx-preserve keeps the loaded timestamp
         across this card's outerHTML swap; OOB swaps still update
         preserved elements in htmx 2.x (explicit-id replace, not swap-
         target traversal). */}}
    <span class="ods-snapshot" id="ods-snapshot-{{.Card.TokenStatsContainer}}" hx-preserve="true">snapshot · —</span>
  </div>
  {{if $live}}
  {{if .Card.TokenStatsContainer}}
  {{/* Usage body self-polls every 8s; hx-preserve keeps it across this
       card's own outerHTML swap so usage data doesn't flicker back to
       "loading usage…" each card-refresh. */}}
  <div class="ods-body" id="ods-body-{{.Card.TokenStatsContainer}}"
       hx-preserve="true"
       hx-get="/partials/open-design/token-stats?name={{ .Card.TokenStatsContainer | qesc }}"
       hx-trigger="load, every 8s"
       hx-swap="outerHTML">
    <div class="ods-body-loading">loading usage…</div>
  </div>
  {{end}}
  {{else}}
  <div class="ods-down">
    <div class="ods-down-warn">
      <span class="ods-down-warn-icon" aria-hidden="true">⚠</span>
      <span>open-design compose project <span class="ods-down-name">{{.Card.Name}}</span> isn't running</span>
    </div>
    <div class="ods-down-explain">
      web ui + token-stats sidecar are both unreachable. lifecycle for this project lives in the <span class="ods-down-strong">containers</span> table above — start the stack there and usage data will return.
    </div>
  </div>
  {{end}}
</div>
{{end}}

{{define "vaults-section"}}
<div id="vaults-section" class="svc-instance vaults"
     hx-get="/partials/services/vaults"
     hx-trigger="every 8s"
     hx-swap="outerHTML">
  <div class="svc-header">
    <span class="svc-icon" title="filesystem MCP vaults">⊟</span>
    <span class="svc-name">vaults</span>
    <span class="svc-endpoint">mcp-fs · allowlist gates agent reads</span>
    <div class="svc-actions">
      <span class="svc-running-count">{{len .Vaults}} configured</span>
    </div>
  </div>
  <div class="vault-rows">
    {{range $i, $v := .Vaults}}
    <details class="vault-row" {{if eq $i 0}}open{{end}}>
      <summary class="vault-row-summary parent-row">
        <span class="vault-row-chev" aria-hidden="true">{{chevSVG}}</span>
        <div class="vault-row-meta">
          <div class="vault-row-line1">
            <span class="vault-row-name">{{$v.Name}}</span>
            <span class="status-pill {{$v.StateClass}}" id="vault-pill-{{$v.Name}}"><span class="dot"></span>{{$v.State}}</span>
            {{if ge $v.AllowedCount 0}}
              {{if eq $v.AllowedCount 0}}
              <span class="vault-allowed-count zero">no allowed paths</span>
              {{else}}
              <span class="vault-allowed-count">{{$v.AllowedCount}} allowed path{{if ne $v.AllowedCount 1}}s{{end}}</span>
              {{end}}
            {{end}}
          </div>
          {{if $v.Description}}<div class="vault-row-desc">{{$v.Description}}</div>{{end}}
        </div>
      </summary>
      {{/* Vault row body — self-polls /partials/vault/panel every 8s
           with hx-preserve so the loaded panel survives this vault
           section's own 8s outerHTML swap. When AllowedCount is -1
           (vault known unreachable at render time) we INLINE the
           unreachable panel so F5 page loads don't flash "loading
           vault…" — drop the `load` from hx-trigger for that case.

           IMPORTANT: inline HTML below must stay in sync with the
           unreachable branch of vault_panel.html.tmpl. */}}
      <div class="vault-row-body" id="vault-{{$v.Name}}-mount"
           hx-preserve="true"
           hx-get="/partials/vault/panel?name={{ $v.Name | qesc }}"
           hx-trigger="{{if lt $v.AllowedCount 0}}every 8s{{else}}load, every 8s{{end}}">
        {{if lt $v.AllowedCount 0}}
        <div class="vault-panel vault-panel-down" id="vault-{{$v.Name}}-panel">
          <div class="svc-unreachable expand-enter">
            <div class="svc-unreachable-warn">
              <span class="svc-unreachable-warn-icon" aria-hidden="true">⚠</span>
              <span>vault <span class="svc-unreachable-name">{{$v.Name}}</span> isn't reachable</span>
            </div>
            <div class="svc-unreachable-explain">
              the mcp-fs control plane didn't respond — allowlist + tree can't be read until it's back. lifecycle for this vault's container lives in the <span class="svc-unreachable-strong">containers</span> table above. the services panel polls every 8s; this card refreshes once it's reachable again.
            </div>
          </div>
        </div>
        {{else}}
        <div class="vault-loading">loading vault…</div>
        {{end}}
      </div>
    </details>
    {{end}}
  </div>
</div>
{{end}}

{{define "instance-section"}}
{{with .Instance}}
<div id="instance-{{.Name}}" class="svc-instance processes" data-instance="{{.Name}}"
     hx-get="/partials/services/instances?name={{ .Name | qesc }}"
     hx-trigger="every 8s"
     hx-swap="outerHTML">
  <div class="svc-header">
    <span class="svc-icon" title="process-compose instance">⚙</span>
    <span class="svc-name">process-compose · {{.Name}}</span>
    <span class="online-dot {{if .Online}}online{{else}}offline{{end}}"
          title="process-compose {{if .Online}}reachable{{else}}unreachable{{end}}"></span>
    <span class="svc-endpoint">{{.Endpoint}}</span>
    <div class="svc-actions">
      {{if .Online}}
      <span class="svc-running-count">{{runningCount .Processes}}/{{len .Processes}} running</span>
      <button class="svc-boot-btn show-internals-btn"
              data-toggle="show-internals"
              title="show internal bridge-* processes for debugging">show internals</button>
      <button class="svc-boot-btn restart"
              hx-post="/compose/reload?instance={{ .Name | qesc }}"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="re-read compose YAML and reconcile (drops removed entries on recent process-compose versions)">reload</button>
      {{else if .CanBoot}}
      <button class="svc-boot-btn start"
              hx-post="/compose/start?instance={{ .Name | qesc }}"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="start process-compose">start</button>
      {{end}}
    </div>
  </div>
  {{if .Online}}
  <table class="process-table">
    <thead><tr>
      <th class="col-name">name</th><th class="col-state">status</th><th class="col-pid">pid</th><th>restarts</th><th>cpu</th><th>mem</th><th>age</th><th class="col-actions"></th>
    </tr></thead>
    <tbody>
    {{$instName := .Name}}
    {{range .Processes}}
    <tr{{if isInternalProcess .}} class="proc-internal"{{end}}>
      <td class="col-name">
        <div class="proc-name">{{.Name}}</div>
        {{if and .Namespace (ne .Namespace "default")}}<div class="proc-ns">{{.Namespace}}</div>{{end}}
      </td>
      <td class="col-state">
        <span class="status-pill {{statusClass .Status}}"><span class="dot"></span>{{.Status}}</span>
        {{if and .HasHealthProbe (or (ne .Health "Ready") (not .IsRunning))}}<span class="health-pill {{healthClass .Health}}" title="readiness: {{.Health}}">{{.Health}}</span>{{end}}
        {{if and (not .IsRunning) (ne .ExitCode 0)}}<span class="exit-code" title="exit code">{{.ExitCode}}</span>{{end}}
      </td>
      {{/* PID/CPU/MEM/AGE are live-only: a Stopped/Completed process keeps its
           last-known PID/mem in process-compose's state, which would render as
           stale "still consuming resources" data. Show — when not running (F5).
           Restarts stays — it's historical. */}}
      <td class="col-pid">{{if and .IsRunning .Pid}}{{.Pid}}{{else}}—{{end}}</td>
      <td>{{.Restarts}}</td>
      <td>
        {{if .IsRunning}}
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill {{cpuBarClass .CPU}}" style="width:{{cpuBarWidth .CPU}}%"></div></div>
          <span class="usage-val">{{printf "%.1f" .CPU}}%</span>
        </div>
        {{else}}<span class="usage-val mute">—</span>{{end}}
      </td>
      <td>
        {{if .IsRunning}}
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill mem" style="width:{{memBarWidth .Mem}}%"></div></div>
          <span class="usage-val">{{formatMem .Mem}}</span>
        </div>
        {{else}}<span class="usage-val mute">—</span>{{end}}
      </td>
      <td>{{if and .IsRunning .SystemTime}}{{.SystemTime}}{{else}}—{{end}}</td>
      <td class="col-actions">
        <div class="proc-actions">
          {{if canStop .Status}}
          <button class="proc-btn stop"
                  hx-get="/partials/blast-radius?action=process-stop&instance={{ $instName | qesc }}&process={{ .Name | qesc }}"
                  hx-target="#blast-slot" hx-swap="innerHTML"
                  title="stop the process (shows what depends on it first)">stop</button>
          {{end}}
          {{if canStart .Status}}
          <button class="proc-btn start"
                  hx-post="/process/start?instance={{ $instName | qesc }}&process={{ .Name | qesc }}"
                  hx-target="#services-inner" hx-swap="outerHTML">start</button>
          {{end}}
          {{if .IsRunning}}
          <button class="proc-btn restart"
                  hx-post="/process/restart?instance={{ $instName | qesc }}&process={{ .Name | qesc }}"
                  hx-target="#services-inner" hx-swap="outerHTML">restart</button>
          {{end}}
          <button class="proc-btn logs"
                  hx-get="/partials/logs?instance={{ $instName | qesc }}&process={{ .Name | qesc }}"
                  hx-target="#logs-{{$instName}}-{{.Name}}"
                  hx-swap="innerHTML">logs</button>
        </div>
        {{/* hx-preserve keeps the loaded logs across the section's 8s poll —
             without it the outerHTML re-render wipes them the instant they
             appear (F4). The poll re-emits this (empty) div with the same id,
             so htmx keeps the existing populated one. */}}
        <div id="logs-{{$instName}}-{{.Name}}" hx-preserve="true"></div>
      </td>
    </tr>
    {{end}}
    </tbody>
  </table>
  {{else}}
  <div class="svc-offline">
    <span class="svc-offline-icon">⚠ unreachable</span>
    <div class="svc-offline-title">process-compose not reachable</div>
    <div class="svc-offline-endpoint">{{.Endpoint}}</div>
    {{if .CanBoot}}
    <button class="svc-boot-btn start"
            hx-post="/compose/start?instance={{ .Name | qesc }}"
            hx-target="#services-inner"
            hx-swap="outerHTML">start process-compose</button>
    {{else}}
    <div class="svc-offline-hint">no binary configured — add <code style="background:var(--bg3);padding:1px 4px;border-radius:3px">binary</code> to config.json to enable bootstrap</div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
{{end}}
