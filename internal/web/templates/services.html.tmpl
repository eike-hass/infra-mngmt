
<div class="svc-grid"
     id="services-inner"
     hx-get="/partials/services"
     hx-trigger="every 8s"
     hx-swap="outerHTML">
{{if .Bridges}}
<div class="svc-instance bridges">
  <div class="svc-header">
    <span class="svc-icon" title="network bridges">⇄</span>
    <span class="svc-name">network bridges</span>
    <span class="svc-endpoint">portproxy + firewall · persistent state</span>
    <div class="svc-actions">
      <span class="svc-running-count">{{activeBridgeCount .Bridges}}/{{len .Bridges}} active</span>
      <button class="svc-boot-btn start"
              hx-post="/bridges/apply"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="re-apply every Windows-tier bridge in one UAC prompt">apply all</button>
      <button class="svc-boot-btn restart"
              hx-post="/bridges/refresh"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="reload bridges.yaml from disk and re-snapshot state">reload</button>
    </div>
  </div>
  <table class="process-table">
    <thead><tr>
      <th class="col-name">name</th><th>tier</th><th class="col-state">state</th><th>listen</th><th>connect</th><th class="col-actions"></th>
    </tr></thead>
    <tbody>
    {{range .Bridges}}
    {{if eq .Kind "composite"}}
    <tr class="bridge-composite" data-composite="{{.Name}}">
      <td colspan="6" class="bridge-composite-cell">
        <div class="bridge-composite-row">
          <span class="bridge-disclosure">{{chevSVG}}</span>
          <span class="proc-name">{{.Name}}</span>
          <span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span>
          <span class="bridge-composite-hops">{{len .Members}} hop{{if ne (len .Members) 1}}s{{end}}</span>
          <span class="kicker bridge-composite-kicker">composite</span>
          {{if .Description}}<span class="bridge-composite-desc">{{.Description}}</span>{{end}}
          <div class="proc-actions bridge-composite-actions">
            <button class="proc-btn start"
                    hx-post="/bridge/apply?name={{.Name}}"
                    hx-target="#services-inner" hx-swap="outerHTML"
                    title="bring composite to active state; skips UAC if Windows portproxy is already in place">apply</button>
            <button class="proc-btn restart"
                    hx-post="/bridge/pause?name={{.Name}}"
                    hx-target="#services-inner" hx-swap="outerHTML"
                    title="pause: stop WSL relay + remove Windows portproxy. Smart-skips elevation if Windows side is already inactive; otherwise UAC."
                    hx-confirm="Pause composite {{.Name}}? Removing the Windows portproxy will request elevation if the rule is currently in place.">pause</button>
            <button class="proc-btn stop"
                    hx-post="/bridge/reset?name={{.Name}}"
                    hx-target="#services-inner" hx-swap="outerHTML"
                    hx-confirm="Reset composite {{.Name}}? This removes the netsh + firewall rules and will request elevation.">reset</button>
          </div>
        </div>
      </td>
    </tr>
    {{$parentName := .Name}}
    {{range .Members}}
    <tr class="bridge-member" data-member-of="{{$parentName}}" hidden>
      <td class="col-name bridge-member-name">
        <span class="bridge-member-indent">└</span>
        <span class="proc-name">{{.Name}}</span>
        {{if .DisplayName}}<div class="proc-ns">{{.DisplayName}}</div>{{end}}
      </td>
      <td><span class="tier-badge {{.Tier}}">{{.Tier}}</span></td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td><code>{{.Listen}}</code></td>
      <td><code>{{.Connect}}</code></td>
      <td class="col-actions"></td>
    </tr>
    {{end}}
    {{else}}
    <tr>
      <td class="col-name">
        <div class="proc-name">{{.Name}}</div>
        {{if .DisplayName}}<div class="proc-ns">{{.DisplayName}}</div>{{end}}
      </td>
      <td><span class="tier-badge {{.Tier}}">{{.Tier}}</span></td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td><code>{{.Listen}}</code></td>
      <td><code>{{.Connect}}</code></td>
      <td class="col-actions">
        <div class="proc-actions">
          <button class="proc-btn start"
                  hx-post="/bridge/apply?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">apply</button>
          {{if eq .Tier "wsl"}}
          <button class="proc-btn restart"
                  hx-post="/bridge/pause?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML"
                  title="pause: stop the relay process; reset to fully remove">pause</button>
          {{end}}
          <button class="proc-btn stop"
                  hx-post="/bridge/reset?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML"
                  hx-confirm="Remove bridge {{.Name}}?">reset</button>
        </div>
      </td>
    </tr>
    {{end}}
    {{end}}
    </tbody>
  </table>
</div>
{{end}}
{{if or .Containers .ContainerProjects}}
<div class="svc-instance containers">
  <div class="svc-header">
    <span class="svc-icon" title="docker containers">⬢</span>
    <span class="svc-name">containers</span>
    {{if .Docker.Configured}}
    <span class="online-dot {{if .Docker.Online}}online{{else}}offline{{end}}"
          title="docker daemon {{if .Docker.Online}}reachable{{else}}unreachable{{if .Docker.Error}} — {{.Docker.Error}}{{end}}{{end}}"></span>
    {{end}}
    <span class="svc-endpoint">{{if .Docker.Endpoint}}docker: {{.Docker.Endpoint}}{{else}}docker: matched by name{{end}}</span>
    <div class="svc-actions">
      <span class="svc-running-count">{{runningContainerCount .Containers}}/{{len .Containers}} running</span>
      <button class="svc-boot-btn restart"
              hx-post="/containers/refresh"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="reload containers.yaml from disk and re-snapshot state">reload</button>
    </div>
  </div>
  <table class="process-table">
    <thead><tr>
      <th class="col-name">name</th><th class="col-state">state</th><th>status</th><th>cpu</th><th>mem</th><th>id</th><th class="col-actions"></th>
    </tr></thead>
    <tbody>
    {{/* Compose-project groups first (prototype: app-services-v3.jsx
         ContainersTable). One header row per ContainerProject with rolled-up
         state + project lifecycle controls, then one row per service
         container. Service rows have no per-row action button — the group
         header owns the lifecycle. */}}
    {{range .ContainerProjects}}
    {{$projName := .Name}}
    <tr class="project-header" data-project="{{.Name}}">
      <td class="col-name">
        <div class="proc-name">
          <span class="project-disclosure">{{chevSVG}}</span>
          <span class="project-name">{{.Name}}</span>
          <span class="kicker project-kind-label">compose</span>
        </div>
        {{if .Description}}<div class="proc-ns">{{.Description}}</div>{{end}}
      </td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td colspan="4">{{if .ComposeFile}}<code class="proc-compose-file">{{.ComposeFile}}</code>{{else}}—{{end}}</td>
      <td class="col-actions">
        <div class="proc-actions">
          {{if eq .StateClass "running"}}
          <button class="proc-btn stop"
                  hx-post="/decl-container/stop?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">stop</button>
          {{else}}
          <button class="proc-btn start"
                  hx-post="/decl-container/start?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">start</button>
          {{end}}
        </div>
      </td>
    </tr>
    {{range .Containers}}
    <tr class="project-member" data-project="{{$projName}}">
      <td class="col-name">
        <span class="project-member-indent">└</span>
        <span class="proc-name">{{.Name}}</span>
      </td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td>{{if .Status}}<code>{{.Status}}</code>{{else}}—{{end}}</td>
      <td>—</td>
      <td>—</td>
      <td>{{if .ID}}<code>{{.ID}}</code>{{else}}—{{end}}</td>
      <td class="col-actions"></td>
    </tr>
    {{end}}
    {{end}}{{/* end range .ContainerProjects */}}
    {{/* Standalone divider — only when BOTH compose stacks and standalone
         containers are present (prototype: line 293 in app-services-v3.jsx). */}}
    {{if and .ContainerProjects .Containers}}
    <tr class="standalone-divider">
      <td colspan="7"><span class="kicker">standalone · {{len .Containers}} container{{if ne (len .Containers) 1}}s{{end}}</span></td>
    </tr>
    {{end}}
    {{range .Containers}}
    <tr>
      <td class="col-name">
        <div class="proc-name">{{.Name}}</div>
        {{if .Description}}<div class="proc-ns">{{.Description}}</div>{{end}}
      </td>
      <td class="col-state"><span class="status-pill {{.StateClass}}"><span class="dot"></span>{{.State}}</span></td>
      <td>{{if .Status}}<code>{{.Status}}</code>{{else}}—{{end}}</td>
      <td>
        {{if .HasStats}}
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill {{cpuBarClass .CPU}}" style="width:{{cpuBarWidth .CPU}}%"></div></div>
          <span class="usage-val">{{printf "%.1f" .CPU}}%</span>
        </div>
        {{else}}—{{end}}
      </td>
      <td>
        {{if .HasStats}}
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill mem" style="width:{{memBarWidth .Mem}}%"></div></div>
          <span class="usage-val">{{formatMem .Mem}}</span>
        </div>
        {{else}}—{{end}}
      </td>
      <td>{{if .ID}}<code>{{.ID}}</code>{{else}}—{{end}}</td>
      <td class="col-actions">
        <div class="proc-actions">
          {{if eq .StateClass "running"}}
          <button class="proc-btn stop"
                  hx-post="/decl-container/stop?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">stop</button>
          {{else if .ID}}
          <button class="proc-btn start"
                  hx-post="/decl-container/start?name={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">start</button>
          {{end}}
        </div>
      </td>
    </tr>
    {{end}}{{/* end range .Containers (standalone rows) */}}
    </tbody>
  </table>
</div>
{{end}}
{{if .OpenDesignProjects}}
{{/* Open Design (kind: open-design) section cards — one per OD compose
     project. Lifecycle controls live in the containers table above; this
     section is read-only: chrome (◇ open design header), meta row, and an
     HTMX-loaded usage body (aggregate stats + per-model chip strip) per
     the design-handoff spec. The card re-renders on the services panel's
     8s poll so a stop/start in the containers table above is reflected
     here too (down explainer ↔ live usage strip). The body's
     hx-trigger="load" re-fires on each re-insertion, which polls the
     sidecar at the same 8s cadence — fine for a local container. */}}
{{range .OpenDesignProjects}}
{{$live := eq .StateClass "running"}}
<div class="svc-instance open-design{{if not $live}} open-design-down{{end}}" id="open-design-{{.Name}}">
  <div class="svc-header">
    <span class="svc-icon od-glyph" title="Open Design compose project">◇</span>
    <span class="svc-name">open design</span>
  </div>
  {{/* Meta row — state-aware. Status pill, project name (dims when down),
       description, web URL chip (muted + non-interactive when down),
       snapshot timestamp slot (populated via OOB), refresh button. */}}
  <div class="ods-meta">
    <span class="status-pill {{.StateClass}}" id="ods-pill-{{.Name}}"><span class="dot"></span>{{.State}}</span>
    <span class="ods-name{{if not $live}} ods-name-dim{{end}}">{{.Name}}</span>
    {{if .Description}}<span class="ods-desc">{{.Description}}</span>{{end}}
    {{if .WebURL}}
    {{if $live}}
    <a class="ods-web-chip" href="{{.WebURL}}" target="_blank" rel="noopener" title="{{.WebURL}}">{{stripScheme .WebURL}}<span class="ods-web-chip-arrow" aria-hidden="true">↗</span></a>
    {{else}}
    <span class="ods-web-chip ods-web-chip-muted" title="web ui unreachable — project is not running">{{stripScheme .WebURL}}<span class="ods-web-chip-arrow" aria-hidden="true">↗</span></span>
    {{end}}
    {{end}}
    <span class="ods-meta-spacer"></span>
    {{/* ID is keyed off TokenStatsContainer (the container/service name)
         so the OOB swap from the token-stats partial finds it — the
         partial doesn't know the project name. */}}
    <span class="ods-snapshot" id="ods-snapshot-{{.TokenStatsContainer}}">snapshot · —</span>
  </div>
  {{if $live}}
  {{if .TokenStatsContainer}}
  <div class="ods-body" id="ods-body-{{.TokenStatsContainer}}"
       hx-get="/partials/open-design/token-stats?name={{.TokenStatsContainer}}"
       hx-trigger="load"
       hx-swap="outerHTML">
    <div class="ods-body-loading">loading usage…</div>
  </div>
  {{end}}
  {{else}}
  {{/* Project-down explainer (matches InstanceUnreachable styling). */}}
  <div class="ods-down expand-enter">
    <div class="ods-down-warn">
      <span class="ods-down-warn-icon" aria-hidden="true">⚠</span>
      <span>open-design compose project <span class="ods-down-name">{{.Name}}</span> isn't running</span>
    </div>
    <div class="ods-down-explain">
      web ui + token-stats sidecar are both unreachable. lifecycle for this project lives in the <span class="ods-down-strong">containers</span> table above — start the stack there and usage data will return.
    </div>
  </div>
  {{end}}
</div>
{{end}}
{{end}}
{{if .Vaults}}
{{/* The vaults section re-renders on every services-panel poll (every 8s),
     mirroring the llama-view pattern. The body's hx-trigger="load" re-fires
     each time the row is inserted, polling /partials/vault/panel at the
     same cadence — fine for a local mcp-fs control plane. */}}
<div class="svc-instance vaults" id="vaults-section">
  <div class="svc-header">
    <span class="svc-icon" title="filesystem MCP vaults">⊟</span>
    <span class="svc-name">vaults</span>
    <span class="svc-endpoint">mcp-fs · allowlist gates agent reads</span>
    <div class="svc-actions">
      <span class="svc-running-count">{{len .Vaults}} configured</span>
    </div>
  </div>
  <div class="vault-rows">
    {{range $i, $v := .Vaults}}
    <details class="vault-row" {{if eq $i 0}}open{{end}}>
      <summary class="vault-row-summary parent-row">
        <span class="vault-row-chev" aria-hidden="true">{{chevSVG}}</span>
        <div class="vault-row-meta">
          <div class="vault-row-line1">
            <span class="vault-row-name">{{$v.Name}}</span>
            <span class="status-pill {{$v.StateClass}}" id="vault-pill-{{$v.Name}}"><span class="dot"></span>{{$v.State}}</span>
            {{if ge $v.AllowedCount 0}}
              {{if eq $v.AllowedCount 0}}
              <span class="vault-allowed-count zero">no allowed paths</span>
              {{else}}
              <span class="vault-allowed-count">{{$v.AllowedCount}} allowed path{{if ne $v.AllowedCount 1}}s{{end}}</span>
              {{end}}
            {{end}}
          </div>
          {{if $v.Description}}<div class="vault-row-desc">{{$v.Description}}</div>{{end}}
        </div>
      </summary>
      <div class="vault-row-body" id="vault-{{$v.Name}}-mount"
           hx-get="/partials/vault/panel?name={{$v.Name}}"
           hx-trigger="load">
        <div class="vault-loading">loading vault…</div>
      </div>
    </details>
    {{end}}
  </div>
</div>
{{end}}
{{if not .Instances}}
  <p style="color:var(--text3);font-style:italic">no process-compose instances configured — add them to config.yaml</p>
{{else}}
{{range $iv := .Instances}}
<div class="svc-instance processes" data-instance="{{$iv.Name}}">
  <div class="svc-header">
    <span class="svc-icon" title="process-compose instance">⚙</span>
    <span class="svc-name">process-compose · {{$iv.Name}}</span>
    <span class="online-dot {{if $iv.Online}}online{{else}}offline{{end}}"
          title="process-compose {{if $iv.Online}}reachable{{else}}unreachable{{end}}"></span>
    <span class="svc-endpoint">{{$iv.Endpoint}}</span>
    <div class="svc-actions">
      {{if $iv.Online}}
      <span class="svc-running-count">{{runningCount $iv.Processes}}/{{len $iv.Processes}} running</span>
      <button class="svc-boot-btn show-internals-btn"
              data-toggle="show-internals"
              title="show internal bridge-* processes for debugging">show internals</button>
      <button class="svc-boot-btn restart"
              hx-post="/compose/reload?instance={{$iv.Name}}"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="re-read compose YAML and reconcile (drops removed entries on recent process-compose versions)">reload</button>
      {{else if $iv.CanBoot}}
      <button class="svc-boot-btn start"
              hx-post="/compose/start?instance={{$iv.Name}}"
              hx-target="#services-inner"
              hx-swap="outerHTML"
              title="start process-compose">start</button>
      {{end}}
    </div>
  </div>
  {{if $iv.Online}}
  <table class="process-table">
    <thead><tr>
      <th class="col-name">name</th><th class="col-state">status</th><th class="col-pid">pid</th><th>restarts</th><th>cpu</th><th>mem</th><th>age</th><th class="col-actions"></th>
    </tr></thead>
    <tbody>
    {{range $iv.Processes}}
    <tr{{if isInternalProcess .}} class="proc-internal"{{end}}>
      <td class="col-name">
        <div class="proc-name">{{.Name}}</div>
        {{if and .Namespace (ne .Namespace "default")}}<div class="proc-ns">{{.Namespace}}</div>{{end}}
      </td>
      <td class="col-state">
        <span class="status-pill {{statusClass .Status}}"><span class="dot"></span>{{.Status}}</span>
        {{/* Health pill is redundant when status=Running + health=Ready
             (the common happy path). Show it only when it adds info:
             probe configured AND (not ready OR not running). */}}
        {{if and .HasHealthProbe (or (ne .Health "Ready") (not .IsRunning))}}<span class="health-pill {{healthClass .Health}}" title="readiness: {{.Health}}">{{.Health}}</span>{{end}}
        {{if and (not .IsRunning) (ne .ExitCode 0)}}<span class="exit-code" title="exit code">{{.ExitCode}}</span>{{end}}
      </td>
      <td class="col-pid">{{if .Pid}}{{.Pid}}{{else}}—{{end}}</td>
      <td>{{.Restarts}}</td>
      <td>
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill {{cpuBarClass .CPU}}" style="width:{{cpuBarWidth .CPU}}%"></div></div>
          <span class="usage-val">{{printf "%.1f" .CPU}}%</span>
        </div>
      </td>
      <td>
        <div class="usage-bar">
          <div class="usage-bar-track"><div class="usage-bar-fill mem" style="width:{{memBarWidth .Mem}}%"></div></div>
          <span class="usage-val">{{formatMem .Mem}}</span>
        </div>
      </td>
      <td>{{if .SystemTime}}{{.SystemTime}}{{else}}—{{end}}</td>
      <td class="col-actions">
        <div class="proc-actions">
          {{if canStop .Status}}
          <button class="proc-btn stop"
                  hx-post="/process/stop?instance={{$iv.Name}}&process={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML"
                  title="halt the process and stop the restart loop">stop</button>
          {{end}}
          {{if canStart .Status}}
          <button class="proc-btn start"
                  hx-post="/process/start?instance={{$iv.Name}}&process={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">start</button>
          {{end}}
          {{if .IsRunning}}
          <button class="proc-btn restart"
                  hx-post="/process/restart?instance={{$iv.Name}}&process={{.Name}}"
                  hx-target="#services-inner" hx-swap="outerHTML">restart</button>
          {{end}}
          <button class="proc-btn logs"
                  hx-get="/partials/logs?instance={{$iv.Name}}&process={{.Name}}"
                  hx-target="#logs-{{$iv.Name}}-{{.Name}}"
                  hx-swap="innerHTML">logs</button>
        </div>
        <div id="logs-{{$iv.Name}}-{{.Name}}"></div>
      </td>
    </tr>
    {{end}}
    </tbody>
  </table>
  {{else}}
  <div class="svc-offline">
    <span class="svc-offline-icon">⚠ unreachable</span>
    <div class="svc-offline-title">process-compose not reachable</div>
    <div class="svc-offline-endpoint">{{$iv.Endpoint}}</div>
    {{if $iv.CanBoot}}
    <button class="svc-boot-btn start"
            hx-post="/compose/start?instance={{$iv.Name}}"
            hx-target="#services-inner"
            hx-swap="outerHTML">start process-compose</button>
    {{else}}
    <div class="svc-offline-hint">no binary configured — add <code style="background:var(--bg3);padding:1px 4px;border-radius:3px">binary</code> to config.json to enable bootstrap</div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
{{end}}
</div>
