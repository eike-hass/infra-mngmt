{{- /*
  Open Design card usage body — replaces the .ods-tokens slot via HTMX on
  card mount (hx-trigger="load"). Renders the aggregate-row stats + the
  per-model chip strip per the design handoff at
  external/handoff/design_handoff_open_design_card/.

  The wrapper outputs three OOB swaps:
    1. The body slot (#ods-body-{name}): aggregate row + chip strip on
       success, or an error line on sidecar failure.
    2. The snapshot timestamp slot (#ods-snapshot-{name}) in the meta row.
    3. The refresh-button data-disabled attribute on the meta row's
       <button id="ods-refresh-{name}">.

  When the project is stopped, the OUTER services.html.tmpl renders the
  down-state explainer inline and never fires this HTMX call.
*/ -}}
{{if .Stats}}
<div class="ods-body" id="ods-body-{{.ServiceName}}">
  <div class="ods-aggregate">
    <div class="ods-stat">
      <span class="kicker">sessions</span>
      <span class="ods-stat-value">{{fmtNum .Stats.Sessions}}</span>
    </div>
    <div class="ods-stat">
      <span class="kicker">messages</span>
      <span class="ods-stat-value">{{fmtNum .Stats.Messages}}</span>
    </div>
    <div class="ods-stat">
      <span class="kicker">tokens in</span>
      <span class="ods-stat-value">{{fmtNum .Stats.InputTokens}}</span>
      <span class="ods-stat-sub">+{{fmtNum .Stats.CacheRead}} cached</span>
    </div>
    <div class="ods-stat">
      <span class="kicker">tokens out</span>
      <span class="ods-stat-value">{{fmtNum .Stats.OutputTokens}}</span>
      <span class="ods-stat-sub">+{{fmtNum .Stats.Reasoning}} reasoning</span>
    </div>
    <div class="ods-stat">
      <span class="kicker">cache hit</span>
      <span class="ods-stat-value ods-stat-good">{{fmtPct .Stats.CacheHitPct}}</span>
    </div>
    <span class="ods-aggregate-spacer"></span>
    <div class="ods-stat ods-stat-cost">
      {{/* When TotalCost is partially or fully composed of equivalent_of
           figures (free / self-hosted models priced as their paid
           comparable), prefix the kicker with "≈" so the aggregate is
           visibly an approximation, not actual spend. */}}
      <span class="kicker">{{if .Stats.TotalIsPartiallyEquivalent}}≈ equiv. cost{{else}}≈ cost{{end}}</span>
      <span class="ods-stat-value ods-stat-accent{{if .Stats.TotalIsPartiallyEquivalent}} ods-stat-value-equiv{{end}}">{{if .Stats.HasTotalCost}}{{fmtUSD .Stats.TotalCost}}{{else}}—{{end}}</span>
    </div>
  </div>
  {{if .Stats.ByModel}}
  <div class="ods-divider"></div>
  <div class="ods-chips">
    <span class="kicker ods-chips-label">by model</span>
    {{range .Stats.ByModel}}
    <div class="ods-chip" style="--m:{{safeCSS .Color}}"
         title="{{.ID}}&#10;{{.Sessions}} sessions · {{.Messages}} messages&#10;{{fmtNum .TokensIn}} in · {{fmtNum .TokensOut}} out · {{fmtNum .CacheRead}} cached&#10;{{fmtPct .CacheHitPct}} cache hit{{if .IsEquivalent}}&#10;cost = paid-equivalent rate (free / self-hosted model){{end}}">
      <span class="ods-chip-dot"></span>
      <span class="ods-chip-name">{{.Short}}</span>
      <span class="ods-chip-out">{{fmtNum .TokensOut}} out</span>
      <span class="ods-chip-cost{{if not .HasCost}} ods-chip-cost-none{{end}}{{if .IsEquivalent}} ods-chip-cost-equiv{{end}}">{{if .HasCost}}{{if .IsEquivalent}}≈{{end}}{{fmtUSD .Cost}}{{else}}—{{end}}</span>
    </div>
    {{end}}
  </div>
  {{end}}
</div>
{{/* OOB swaps for the snapshot timestamp + refresh-button enabled state. */}}
<span class="ods-snapshot" id="ods-snapshot-{{.ServiceName}}" hx-swap-oob="true">snapshot · {{if .Stats.GeneratedAt}}{{.Stats.GeneratedAt}}{{else}}—{{end}}</span>
{{else}}
{{/* Error copy depends on ErrorKind so the message reflects the actual
     failure mode. "unreachable" is reserved for network failures; HTTP
     errors are labelled "sidecar error" and carry a body snippet. The
     services panel polls every 8s so the body re-fetches on its own once
     the sidecar recovers — no manual retry button. */}}
<div class="ods-body ods-body-error ods-body-error-{{if .ErrorKind}}{{.ErrorKind}}{{else}}other{{end}}" id="ods-body-{{.ServiceName}}">
  <span class="ods-error-icon" aria-hidden="true">⚠</span>
  <span class="ods-error-text">{{.Error}}</span>
</div>
<span class="ods-snapshot" id="ods-snapshot-{{.ServiceName}}" hx-swap-oob="true">snapshot · —</span>
{{end}}
