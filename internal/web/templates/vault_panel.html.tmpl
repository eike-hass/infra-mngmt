
<div class="vault-panel{{if eq .ErrorKind "unreachable"}} vault-panel-down{{end}}" id="vault-{{.Name}}-panel">
  {{if eq .ErrorKind "unreachable"}}
  {{/* Vault sidecar unreachable — full centered explainer + retry button +
       a jump to the containers table where the vault's lifecycle lives.
       Matches the OD card's project-down treatment + prototype's
       InstanceUnreachable. */}}
  <div class="svc-unreachable expand-enter">
    <div class="svc-unreachable-warn">
      <span class="svc-unreachable-warn-icon" aria-hidden="true">⚠</span>
      <span>vault <span class="svc-unreachable-name">{{.Name}}</span> isn't reachable</span>
    </div>
    <div class="svc-unreachable-explain">
      the mcp-fs control plane didn't respond — allowlist + tree can't be read until it's back. lifecycle for this vault's container lives in the <span class="svc-unreachable-strong">containers</span> table above. the services panel polls every 8s; this card refreshes once it's reachable again.
    </div>
  </div>
  {{else}}
  {{if .Error}}
    {{/* Partial failure — allowlist worked but tree fetch failed. Keep the
         small inline banner so the operator still sees + can use the
         allowlist below. */}}
    <div class="vault-error">{{.Error}}</div>
  {{end}}
  <div class="vault-section">
    <div class="kicker vault-section-label">{{len .Allowed}} allowed path{{if ne (len .Allowed) 1}}s{{end}}</div>
    {{if .Allowed}}
      <div class="vault-allow-list">
      {{range .Allowed}}
        <div class="vault-allow-row mono">
          <span class="vault-flag-allowed">allowed</span>
          <code>{{.}}</code>
          <span class="vault-allow-spacer"></span>
          <button class="vault-revoke-btn"
                  hx-post="/api/vault/disallow?name={{$.Name | qesc}}&path={{. | qesc}}"
                  hx-target="#vault-{{$.Name}}-mount"
                  hx-swap="innerHTML">remove</button>
        </div>
      {{end}}
      </div>
    {{else}}
      <div class="vault-empty">No paths allowed yet — agents can't read anything from this vault.</div>
    {{end}}
  </div>
  <details class="vault-browse">
    <summary class="vault-browse-summary kicker"><span class="summary-chev">{{chevSVG}}</span>browse + add paths</summary>
    {{if .Tree}}
      {{template "vault-tree" .Tree}}
    {{end}}
  </details>
  {{end}}
</div>
{{define "vault-tree"}}
<div class="vault-tree" id="vault-tree-{{.Name}}">
  <div class="vault-tree-cwd-row mono">
    <span class="vault-tree-cwd-icon">▸</span>
    <code class="vault-tree-cwd-path">{{.Path}}</code>
    {{if .ParentPath}}
      <button class="vault-tree-up"
              hx-get="/partials/vault/tree?name={{.Name | qesc}}&at={{.ParentPath | qesc}}"
              hx-target="#vault-tree-{{.Name}}" hx-swap="outerHTML"
              title="up one directory">../</button>
    {{end}}
  </div>
  {{range .Entries}}
    <div class="vault-tree-row mono">
      <span class="vault-tree-icon">▸</span>
      <button class="vault-tree-into"
              hx-get="/partials/vault/tree?name={{$.Name | qesc}}&at={{.Full | qesc}}"
              hx-target="#vault-tree-{{$.Name}}" hx-swap="outerHTML">{{$.Path}}/<span class="vault-tree-name">{{.Name}}</span>/</button>
      {{if .Allowed}}
        <span class="vault-flag-allowed" title="this path is explicitly listed in the allowlist">allowed</span>
      {{else if .CoveredBy}}
        <span class="vault-tree-covered" title="covered transitively by an ancestor; adding explicitly lets you keep this entry if you later remove the ancestor">covered by <code>{{.CoveredBy}}</code></span>
        <button class="vault-tree-allow-btn"
                hx-post="/api/vault/allow?name={{$.Name | qesc}}&path={{.Full | qesc}}&at={{$.Path | qesc}}"
                hx-target="#vault-{{$.Name}}-mount"
                hx-swap="innerHTML"
                title="add an explicit entry — useful if the ancestor gets removed later">allow here</button>
      {{else}}
        <button class="vault-tree-allow-btn primary"
                hx-post="/api/vault/allow?name={{$.Name | qesc}}&path={{.Full | qesc}}&at={{$.Path | qesc}}"
                hx-target="#vault-{{$.Name}}-mount"
                hx-swap="innerHTML">+ allow</button>
      {{end}}
    </div>
  {{else}}
    <div class="vault-empty">No subdirectories.</div>
  {{end}}
</div>
{{end}}
