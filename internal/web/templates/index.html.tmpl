<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>infra-mngmt</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<script src="{{static "vendor/htmx.min.js"}}"></script>
<script src="{{static "vendor/fuse.min.js"}}"></script>
<script src="{{static "vendor/marked.min.js"}}"></script>
<link rel="stylesheet" href="{{static "css/app.css"}}">
</head>
<body>

<div id="toast-stack" class="toast-stack" aria-live="polite"></div>
{{/* Page-level mount for the blast-radius confirm modal (services-panel
     destructive actions render here so the 8s section polling can't clobber it). */}}
<div id="blast-slot"></div>

<header>
  <span class="logo"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 20" width="28" height="20"><polygon points="8,2 14,2 17,7 14,12 8,12 5,7" fill="var(--accent)" opacity="0.95"/><polygon points="13,8 19,8 22,13 19,18 13,18 10,13" fill="none" stroke="var(--accent)" stroke-width="1.2" opacity="0.55"/></svg></span>

  <div class="view-tabs">
    <button class="view-tab active" id="vtab-entities">config</button>
    <button class="view-tab" id="vtab-llama">llama</button>
    <button class="view-tab" id="vtab-services">services</button>
  </div>

  <div class="divider"></div>

  <div class="tab-scroll-wrap" id="tab-scroll-wrap">
    <button class="tab-scroll-btn" data-dir="left">‹</button>
    <div class="source-tabs" id="source-tabs-bar">
      <button class="tab active" data-project="__all__">all</button>
      {{range .Sources}}
      <button class="tab" data-project="{{.Key}}">
        {{.Label}}{{range .Levels}}<span class="scope-badge {{.}}" title="{{.}}">{{.}}</span>{{end}}
      </button>
      {{end}}
    </div>
    <button class="tab-scroll-btn" data-dir="right">›</button>
  </div>

  <button class="topbar-btn topbar-rescan" id="ov-rescan" title="Rescan sources — discover new projects / devcontainers" aria-label="rescan sources"><span class="topbar-rescan-icon" aria-hidden="true">↻</span></button>

  <label class="search-wrap" for="search" title="Search (⌘K)">
    <svg class="search-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5"></circle>
      <path d="M10.5 10.5l3 3"></path>
    </svg>
    <input id="search" type="text" placeholder="⌘K search" autocomplete="off">
  </label>
</header>

<div id="view-entities" class="card-shell">
  <div id="project-overview" style="display:none">
    <div class="ov-row" id="ov-row">
      <span class="ov-name" id="ov-name" style="display:none"></span>
      <span class="ov-scopes" id="ov-scopes" style="display:none"></span>
      <span class="ov-sep" id="ov-sep" style="display:none">·</span>
      <span class="ov-counts" id="ov-counts" style="display:none"></span>
      <span class="ov-spacer"></span>
      <div class="ov-ctr" id="ov-ctr"></div>
      <span class="ov-toggle" id="ov-toggle" style="display:none">{{chevSVG}}</span>
    </div>
    <div class="ov-detail" id="ov-detail" style="display:none"></div>
    <div id="ov-log-panel" style="display:none"></div>
  </div>
  <main class="entity-pane">
    <aside class="entity-sidebar" aria-label="entities">
      <div class="kind-bar" id="kind-bar" role="tablist" aria-label="filter by kind">
        <button class="pill active" data-kind="all">all</button>
        <button class="pill" data-kind="mcp_server" title="MCP servers"><span class="pill-icon">⬡</span><span class="pill-label">MCP</span></button>
        <button class="pill" data-kind="command" title="commands"><span class="pill-icon">$</span><span class="pill-label">commands</span></button>
        <button class="pill" data-kind="agent" title="agents"><span class="pill-icon">◉</span><span class="pill-label">agents</span></button>
        <button class="pill" data-kind="skill" title="skills"><span class="pill-icon">✦</span><span class="pill-label">skills</span></button>
        <button class="pill" data-kind="hook" title="hooks"><span class="pill-icon">↪</span><span class="pill-label">hooks</span></button>
        <button class="pill" data-kind="memory" title="memory"><span class="pill-icon">▤</span><span class="pill-label">memory</span></button>
        <button class="pill" data-kind="claude_md" title="CLAUDE.md"><span class="pill-icon">#</span><span class="pill-label">CLAUDE.md</span></button>
      </div>
      <div class="entity-list" id="entity-list">
        {{template "entity-list-inner" .}}
      </div>
    </aside>
    <div class="preview" id="preview">
      <div class="preview-empty">
        <div class="preview-empty-icons">
          <span class="kind-icon mcp_server">⬡</span>
          <span class="kind-icon command">$</span>
          <span class="kind-icon agent">◉</span>
          <span class="kind-icon skill">✦</span>
          <span class="kind-icon hook">↪</span>
        </div>
        <div class="preview-empty-title">select an entity to inspect</div>
        <div class="preview-empty-hint">click any entity on the left to view its config,<br>source path, runtime status, or open the markdown body for editing.</div>
        <div class="preview-empty-kbd"><kbd>⌘K</kbd><span>to search</span></div>
      </div>
    </div>
  </main>
</div>

<div id="view-services"
     hx-get="/partials/services"
     hx-trigger="revealed once"
     hx-swap="innerHTML">
  <p class="svc-section-placeholder">loading services…</p>
</div>

<div id="view-llama"
     hx-get="/partials/llama"
     hx-trigger="revealed once"
     hx-swap="innerHTML">
  <p class="svc-section-placeholder">loading llama servers…</p>
</div>

<script type="module" src="{{static "js/app.js"}}"></script>
<script type="module" src="{{static "js/preview.js"}}"></script>
<script type="module" src="{{static "js/containers.js"}}"></script>
<script type="module" src="{{static "js/promote.js"}}"></script>
{{if .WakeURL}}
<span class="wake-chip" id="wake-chip" data-wake-url="{{.WakeURL}}">
  <span class="wake-chip-label">waking</span>
  <span class="wake-chip-elapsed" id="wake-chip-elapsed"></span>
</span>
<script type="module" src="{{static "js/wake.js"}}"></script>
{{end}}

{{with .Build}}
{{if or .BuildEpoch .Commit}}
<span class="build-chip" id="build-chip"
      title="commit {{if .Commit}}{{.Commit}}{{else}}(unknown){{end}}{{if .Dirty}}-dirty{{end}}{{if .VCSTime}} · committed {{.VCSTime}}{{end}}{{if .BuildEpoch}} · built {{.BuildEpoch}}{{end}}{{if .GoVersion}} · {{.GoVersion}}{{end}}"
      data-epoch="{{.BuildEpoch}}"
      data-commit="{{.Commit}}">
  <span class="build-chip-commit">{{if .Commit}}{{.Commit}}{{else}}local{{end}}{{if .Dirty}}+{{end}}</span>
  <span class="build-chip-when" id="build-chip-when">{{.BuildEpoch}}</span>
  <span class="build-chip-reload" id="build-chip-reload" aria-hidden="true">↻</span>
</span>
{{end}}
{{end}}
</body>
</html>
